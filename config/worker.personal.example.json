{
  "service_url": "http://127.0.0.1:3000",
  "worker_id": "worker-1",
  "token_env": "WORKER_WORKER_1_TOKEN",
  "artifact_dir": "/absolute/path/worker-state/jobs",
  "targets": [
    {
      "id": "worker-1-openai-local",
      "account_id": "codex-personal",
      "provider": "openai",
      "mode": "local",
      "binary": "/absolute/path/to/codex",
      "auth_dir": "/absolute/path/worker-state/accounts/codex-personal",
      "repositories": {
        "my-project": {
          "path": "/absolute/path/my-project"
        }
      },
      "label": "Codex personal",
      "billing": "unknown",
      "setup_minutes": 10
    },
    {
      "id": "worker-1-anthropic-local",
      "account_id": "claude-personal-main",
      "provider": "anthropic",
      "mode": "local",
      "binary": "/absolute/path/to/claude",
      "auth_dir": "/absolute/path/worker-state/accounts/claude-personal",
      "repositories": {
        "my-project": {
          "path": "/absolute/path/my-project"
        }
      },
      "label": "Claude personal",
      "billing": "unknown",
      "setup_minutes": 10
    },
    {
      "id": "worker-1-cursor-local",
      "account_id": "cursor-personal",
      "provider": "cursor",
      "mode": "local",
      "binary": "/absolute/path/to/cursor-agent",
      "auth_dir": "/absolute/path/worker-state/accounts/cursor-personal",
      "repositories": {
        "my-project": {
          "path": "/absolute/path/my-project"
        }
      },
      "label": "Cursor personal",
      "billing": "unknown",
      "setup_minutes": 10,
      "default_model": "auto"
    }
  ]
}
