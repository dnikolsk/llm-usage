{
  "service_url": "http://127.0.0.1:3000",
  "worker_id": "cloud-dev",
  "token_env": "WORKER_CLOUD_DEV_TOKEN",
  "artifact_dir": "/workspace/.cloud-setup/jobs",
  "targets": [
    {
      "id": "codex-personal-local",
      "account_id": "codex-personal",
      "provider": "openai",
      "mode": "local",
      "binary": "/workspace/.subscription-workers/clis/node_modules/.bin/codex",
      "auth_dir": "/workspace/.cloud-setup/accounts/codex-personal",
      "repositories": {
        "llm-usage": {
          "path": "/workspace/llm-usage"
        },
        "ai-builder-tools": {
          "path": "/workspace/ai-builder-tools"
        }
      },
      "label": "Codex personal",
      "billing": "unknown",
      "setup_minutes": 10
    },
    {
      "id": "claude-personal-local",
      "account_id": "claude-personal-main",
      "provider": "anthropic",
      "mode": "local",
      "binary": "/workspace/.subscription-workers/clis/node_modules/.bin/claude",
      "auth_dir": "/workspace/.cloud-setup/accounts/claude-personal",
      "repositories": {
        "llm-usage": {
          "path": "/workspace/llm-usage"
        },
        "ai-builder-tools": {
          "path": "/workspace/ai-builder-tools"
        }
      },
      "label": "Claude personal",
      "billing": "unknown",
      "setup_minutes": 10
    },
    {
      "id": "cursor-personal-local",
      "account_id": "cursor-personal",
      "provider": "cursor",
      "mode": "local",
      "binary": "/workspace/.subscription-workers/cursor-2026.09.28-64d2043/cursor-agent",
      "auth_dir": "/workspace/.cloud-setup/accounts/cursor-personal",
      "repositories": {
        "llm-usage": {
          "path": "/workspace/llm-usage"
        },
        "ai-builder-tools": {
          "path": "/workspace/ai-builder-tools"
        }
      },
      "label": "Cursor personal",
      "billing": "unknown",
      "setup_minutes": 10
    }
  ]
}
