# EXAMPLE ONLY: replace all placeholder values before running or deploying.
# See docs/deployment.md for which credentials belong on each process.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
READ_TOKEN=replace-with-long-random-read-secret
WRITE_TOKEN=replace-with-different-long-random-write-secret
JOB_TOKEN=replace-with-independent-long-random-job-secret
ADMIN_TOKEN=replace-with-independent-long-random-admin-secret
WORKER_WORKER_1_TOKEN=replace-with-independent-long-random-worker-secret

# Private dashboard password (32+ characters); never expose as NEXT_PUBLIC_*
DASHBOARD_PASSWORD=replace-with-independent-long-dashboard-password

# Optional: comma-separated exact browser origins allowed to access MCP.
# MCP_ALLOWED_ORIGINS=https://your-trusted-client.example
