# Next.js loads apps/web/.env.local. Other workspace commands need exported variables.
DATABASE_URL=postgresql://localhost:5432/llm_usage
# Generate each value independently (at least 32 characters), e.g. openssl rand -hex 32.
READ_TOKEN=
WRITE_TOKEN=
DASHBOARD_PASSWORD=
# Optional: only POST /v1/route needs a TypeSafe Jev key.
TYPESAFE_API_KEY=
